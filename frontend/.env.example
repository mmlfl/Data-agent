# Frontend development proxy targets the existing backend at 127.0.0.1:8000.
# Milvus HTTP sync is not implemented by the current backend. Set this to the
# same-origin route provided by your backend when available, or edit it in UI.
VITE_MILVUS_SYNC_URL=/api/milvus/sync

# Optional build-time defaults. Prefer entering tokens in Metadata > API settings
# for this browser session. VITE_* values are visible in the frontend bundle.
# VITE_CACHE_SYNC_TOKEN=
# VITE_MILVUS_SYNC_TOKEN=
