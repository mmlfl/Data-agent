# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
STREAM_RESPONSES=true
LLM_TEMPERATURE=0.2

# Database (WITH_DB=true 时生效)
WITH_DB=false
DB_DIALECT=dm
# DB_DIALECT=mysql

DB_HOST=localhost
DB_PORT=5236
# MySQL 示例: DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_POOL_SIZE=5
# 服务端硬上限（UI 全量与 DB fetch 共用）；LLM 侧仍只看少量样本
# DB_MAX_RESULT_ROWS=500

# API Server (python main.py serve)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG / Milvus（Milvus 在虚拟机 Docker）
RAG_ENABLED=false
# 示例：http://192.168.56.101:19530；本地 .env 必须填写真实虚拟机 IP
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=sql_agent_knowledge_fake_v1
MILVUS_TEST_COLLECTION=sql_agent_test_knowledge_fake_v1
MILVUS_CONNECT_TIMEOUT_SECONDS=5
MILVUS_SEARCH_TIMEOUT_SECONDS=3
MILVUS_EXPECTED_SERVER_VERSION=2.6.22
RAG_DATABASE_ID=career_demo
RAG_TENANT_ID=local
RAG_FAIL_OPEN=true
