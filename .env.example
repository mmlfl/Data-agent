# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
STREAM_RESPONSES=true
LLM_TEMPERATURE=0.2
# 每轮最多6次SQL工具请求、3次失败（含校验拒绝）；临时连接故障仅额外重试一次
MAX_TOOL_ITERATIONS=10
MAX_SQL_ATTEMPTS=6
MAX_SQL_REPAIRS=3
MAX_REQUEST_SECONDS=180

# Database (WITH_DB=true 时生效)
WITH_DB=false
DB_DIALECT=dm
# DB_DIALECT=mysql

DB_HOST=localhost
DB_PORT=5236
# MySQL 示例: DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_POOL_SIZE=5
# AST 在 SQL 中强制限行；配置可缩小，不能超过 100 行
DB_MAX_RESULT_ROWS=100
# 数据库执行超时（秒）；不是仅限制 Python 等待时间
DB_QUERY_TIMEOUT_SECONDS=30

# API Server (python main.py serve)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG / Milvus（Milvus 在虚拟机 Docker）
RAG_ENABLED=false
# 示例：http://192.168.56.101:19530；本地 .env 必须填写真实虚拟机 IP
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=sql_agent_knowledge_fake_v1
MILVUS_TEST_COLLECTION=sql_agent_test_knowledge_fake_v1
MILVUS_CONNECT_TIMEOUT_SECONDS=5
MILVUS_SEARCH_TIMEOUT_SECONDS=3
MILVUS_EXPECTED_SERVER_VERSION=2.6.22
RAG_DATABASE_ID=career_demo
RAG_TENANT_ID=local
RAG_FAIL_OPEN=true

# 正式单表 Schema 存储；与上述 8 维练习 Collection 分开
MILVUS_SCHEMA_COLLECTION=sql_agent_schema_v1
RAG_DATABASE_NAME=就业服务库
MILVUS_ACTION_TIMEOUT_SECONDS=60
# 由显式 sync-schema 命令使用，普通启动不调用 Embedding
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# BASE_URL 从百炼控制台复制对应地域的 OpenAI 兼容模式地址
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30

# 用户确认后的 SQL 样例与逻辑关系；RAG_ENABLED 控制实际云端检索/向量化
SQL_AGENT_KNOWLEDGE_DB_PATH=data/sql_agent_knowledge.db
MILVUS_MEMORY_COLLECTION=sql_agent_sql_memory_v1
